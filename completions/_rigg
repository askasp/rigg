#compdef rigg
# zsh completion. Install with:
#   mkdir -p ~/.zfunc && cp completions/_rigg ~/.zfunc/
#   echo 'fpath=(~/.zfunc $fpath); autoload -U compinit; compinit' >> ~/.zshrc

_rigg_stacks() {
  local -a names
  names=(${(f)"$(rigg stack names 2>/dev/null)"})
  _describe 'stack' names
}

_rigg_branches() {
  local -a names
  names=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads refs/remotes 2>/dev/null)"})
  _describe 'branch' names
}

_rigg() {
  local -a cmds
  cmds=(
    'new:Start a new stack and run a pipeline on it'
    'adopt:Take an existing branch into a stack and run a pipeline on it'
    'add:Append the next branch to a stack'
    'say:Send a follow-up prompt to a stack'
    'attach:Open an agent on a stack'
    'logs:Show a run log'
    'run:Run the pipeline here'
    'status:Show branch and stack state'
    'stop:Stop a run that is still going'
    'continue:Take a branch further than the pipeline it ran'
    'plan:Show the steps a run would take, and on which model'
    'pipelines:List the pipeline names'
    'features:Show the optional parts of the pipeline'
    'doctor:Check the environment'
    'stack:Manage stacks'
    'init:Write a starter rigg.toml'
  )
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
    return
  fi
  # --image takes a file, wherever it appears.
  if [[ "${words[CURRENT-1]}" == "--image" ]]; then
    _files
    return
  fi
  case "${words[2]}" in
    add|say|attach|logs|stop|continue) (( CURRENT == 3 )) && _rigg_stacks ;;
    adopt) (( CURRENT == 3 )) && _rigg_branches ;;
    stack) (( CURRENT == 3 )) && _values 'subcommand' push list names prune pr rm ;;
  esac
}

_rigg "$@"
