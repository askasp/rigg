# Copy to ~/.rigg/secrets/<instance>.env — outside the repo, because the sync,
# the MCP server, the Slack bridge and anything a timer starts all read the
# same file. `default` is the name of the unnamed instance.
#
#   mkdir -p ~/.rigg/secrets && chmod 700 ~/.rigg/secrets

# Front API token. Read access is enough to build the corpus; putting drafts
# back needs `drafts:write` as well.
FRONT_API_TOKEN=

# The teammate a draft is attributed to. Without it Front credits the API token
# and the draft goes out unsigned, so the server refuses rather than guessing.
FRONT_AUTHOR_ID=

# Where a run with no Slack thread reports — a scheduled one, or one started in
# a terminal. Unset, those runs report nowhere, which is the old behaviour.
RIGG_NOTIFY_CHANNEL=
